# Copy to .env.local (local) and set the same names in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Empty values mean "not provided yet".

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Used for callbacks, sitemap, Open Graph. Example: https://ragam.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets for protected endpoints (generate: openssl rand -hex 32; min 16 chars) ---
JOB_SECRET_TOKEN=
REVALIDATE_SECRET_TOKEN=

# --- Duitku (Phase 5, optional until then) ---
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# sandbox | production
DUITKU_ENV=sandbox

# --- RajaOngkir / Komerce (Phase 3, optional until then) ---
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=

# --- Alerts (Phase 8, optional): use ONE of the two ---
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Analytics (Phase 7, optional) ---
NEXT_PUBLIC_ANALYTICS_ID=
